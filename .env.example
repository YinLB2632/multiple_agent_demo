# ============================================================
#  AI 产品团队 - 配置模板
#  用法：把本文件复制成 .env ，填上你自己的 key
#  Windows PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 1. AI 大脑（必填）----------
# 选一家国产模型，或用自己的模型中转站。默认 deepseek，最省心便宜。
# 可选值：deepseek | dashscope | zhipu | moonshot | openai | custom
LLM_PROVIDER=deepseek

# 对应家的 API Key（只填你选的那家即可）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# 可选：手动指定模型名（留空则用该家的默认模型）
# deepseek 默认 deepseek-chat / dashscope 默认 qwen-plus
# zhipu 默认 glm-4-flash / moonshot 默认 moonshot-v1-8k
# LLM_PROVIDER=custom 时必填，填中转站要求的模型名（如 gpt-4o、claude-3-5-sonnet 等）
LLM_MODEL=

# ---------- 1.1 自定义模型中转站（LLM_PROVIDER=custom 时使用）----------
# 适用于你自己接的代理/聚合服务（一般是 OpenAI 兼容接口）。
# 三项都必填：接口地址、中转站的 key、上面的 LLM_MODEL。
# 示例：CUSTOM_BASE_URL=https://your-proxy.com/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---------- 2. 联网搜索（可选）----------
# 不填也能跑：调研阶段会标注"未联网，基于已有知识"。
# 填了就查真实竞品/市场数据。
# 可选值：tavily | bocha | none
SEARCH_PROVIDER=tavily

# Tavily（国外，免费额度每月 1000 次）：https://tavily.com
TAVILY_API_KEY=

# 博查 AI（国产搜索）：https://bochaai.com
BOCHA_API_KEY=

# ---------- 2.5 评审专家独立模型（可选）----------
# 不填就跟其它角色共用主模型（LLM_PROVIDER）。
# 建议单独配一个不同的模型/厂商来做评审，避免写手和评审用同一个模型，
# 出现"自己检查自己作业"、写手的盲区评审也发现不了的问题。
# 可选值同 LLM_PROVIDER：deepseek | dashscope | zhipu | moonshot | openai | custom
REVIEWER_LLM_PROVIDER=

# 可选：手动指定评审用的模型名（留空则用该家的默认模型）
REVIEWER_LLM_MODEL=

# REVIEWER_LLM_PROVIDER=custom 时使用（评审专用的中转站接入信息）
REVIEWER_CUSTOM_BASE_URL=
REVIEWER_CUSTOM_API_KEY=

# ---------- 2.6 备用模型（可选，降级用）----------
# 不填就不启用降级：主模型（或评审模型）调用失败时直接报错，跟以前一样。
# 填了的话，主模型调用失败（服务挂了/欠费/超时耗尽重试）会自动切到这里配置的
# 模型重试一次，避免整条流水线因为某一家服务临时故障而跑不下去。
# 可选值同 LLM_PROVIDER：deepseek | dashscope | zhipu | moonshot | openai | custom
FALLBACK_LLM_PROVIDER=

# 可选：手动指定备用模型名（留空则用该家的默认模型）
FALLBACK_LLM_MODEL=

# FALLBACK_LLM_PROVIDER=custom 时使用（备用中转站接入信息）
FALLBACK_CUSTOM_BASE_URL=
FALLBACK_CUSTOM_API_KEY=

# ---------- 3. 质量控制（可选，有默认值）----------
# PRD 评审合格线（0-100），达不到会自动返修
PRD_PASS_SCORE=80
# 最多返修几轮，防止无限循环
MAX_REVISION_ROUNDS=2
# 澄清最多问几轮
MAX_CLARIFY_ROUNDS=2
