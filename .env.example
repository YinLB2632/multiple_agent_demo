# ============================================================
#  AI 产品团队 - 配置模板
#  用法：把本文件复制成 .env ，填上你自己的 key
#  Windows PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 1. AI 大脑（必填）----------
# 选一家国产模型。默认 deepseek，最省心便宜。
# 可选值：deepseek | dashscope | zhipu | moonshot | openai
LLM_PROVIDER=deepseek

# 对应家的 API Key（只填你选的那家即可）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# 可选：手动指定模型名（留空则用该家的默认模型）
# deepseek 默认 deepseek-chat / dashscope 默认 qwen-plus
# zhipu 默认 glm-4-flash / moonshot 默认 moonshot-v1-8k
LLM_MODEL=

# ---------- 2. 联网搜索（可选）----------
# 不填也能跑：调研阶段会标注"未联网，基于已有知识"。
# 填了就查真实竞品/市场数据。
# 可选值：tavily | bocha | none
SEARCH_PROVIDER=tavily

# Tavily（国外，免费额度每月 1000 次）：https://tavily.com
TAVILY_API_KEY=

# 博查 AI（国产搜索）：https://bochaai.com
BOCHA_API_KEY=

# ---------- 3. 质量控制（可选，有默认值）----------
# PRD 评审合格线（0-100），达不到会自动返修
PRD_PASS_SCORE=80
# 最多返修几轮，防止无限循环
MAX_REVISION_ROUNDS=2
# 澄清最多问几轮
MAX_CLARIFY_ROUNDS=2
